# Streamlit Secrets — EXAMPLE FILE
# Copy this file to .streamlit/secrets.toml and fill in your real credentials.
# NEVER commit secrets.toml to version control.

# Groq API key (FREE — no payment method required)
# Obtain from: https://console.groq.com
GROQ_API_KEY = "gsk_your-key-here"

# Google Maps Platform API key
# Obtain from: https://console.cloud.google.com/google/maps-apis
# Required APIs: Places API (new or legacy), Geocoding API
MAPS_API_KEY = "your-google-maps-api-key-here"
